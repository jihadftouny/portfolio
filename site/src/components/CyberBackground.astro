---
/*
  The cyberpunk backdrop, replacing the space nebula. Same performance
  contract as its predecessor: position fixed so scrolling never repaints it,
  static gradients the GPU rasterises once, and the only animation is a slow
  transform-and-opacity drift that stays on the compositor.

  It reads the page accent, so the floor grid and glow shift hue with the
  per-page identity: cyan on Work, violet on Teaching, amber on Games.
*/
---

<div class="cyber" aria-hidden="true">
  <div class="cyber__glow"></div>
  <div class="cyber__grid"></div>
  <div class="cyber__scan"></div>
  <div class="cyber__vignette"></div>
</div>

<style>
  .cyber {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, var(--bg-deep) 0%, #0d1120 55%, var(--bg-near) 100%);
  }

  /* Two soft neon spots instead of nebulae. Accent-aware. */
  .cyber__glow {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(
        34% 26% at 82% 10%,
        color-mix(in srgb, var(--accent) 13%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        30% 24% at 10% 32%,
        color-mix(in srgb, var(--accent-violet) 11%, transparent) 0%,
        transparent 72%
      );
    animation: drift 52s ease-in-out infinite alternate;
  }

  /* The neon floor: a perspective grid receding to a horizon. The transform
     is static, so it rasterises once like everything else here. */
  .cyber__grid {
    position: absolute;
    inset-inline: -30%;
    bottom: -8%;
    height: 52vh;
    background:
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--accent) 20%, transparent) 0 1px,
        transparent 1px 56px
      ),
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--accent) 15%, transparent) 0 1px,
        transparent 1px 46px
      );
    transform: perspective(55vh) rotateX(62deg);
    transform-origin: 50% 100%;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 62%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 62%);
    opacity: 0.45;
  }

  /* Faint CRT scanlines across the whole wall. Behind the content layer, so
     text renders on top of them, never through them. */
  .cyber__scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.16) 0 1px,
      transparent 1px 4px
    );
    opacity: 0.35;
  }

  .cyber__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 100% at 50% 38%, transparent 45%, rgba(0, 0, 0, 0.5) 100%);
  }

  @keyframes drift {
    from { transform: translate3d(0, 0, 0) scale(1); opacity: 1; }
    to   { transform: translate3d(2%, -1.5%, 0) scale(1.05); opacity: 0.82; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cyber__glow { animation: none; }
  }
</style>
