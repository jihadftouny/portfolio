---
/*
  Back-to-home band: its own full-width strip between a page's last section
  and the footer, on every destination page. The link sits centered between
  two accent hairlines, an end-of-transmission mark.

  Cyberpunk chrome on the link itself: the secondary face in full caps, the
  page accent for colour so it re-themes per destination, and the same cut
  corner the achievement plates use. The arrow is an inline SVG rather than
  a glyph, because Orbitron has no arrows and a fallback-font arrow next to
  Orbitron caps looks borrowed.
*/
---

<section class="backband">
  <div class="page backband__inner" data-reveal>
    <a class="backhome" href="/">
      <svg
        class="backhome__arrow"
        viewBox="0 0 16 10"
        width="16"
        height="10"
        aria-hidden="true"
      >
        <path
          d="M15 5H2M6 1 2 5l4 4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
      </svg>
      Back to Home
    </a>
  </div>
</section>

<style>
  /* No padding of its own: the last section's bottom padding and the
     footer's top margin already hold the band at a sensible distance. */
  .backband__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  /* The hairlines fade outward, so the band ends soft at the page edges. */
  .backband__inner::before,
  .backband__inner::after {
    content: "";
    height: 1px;
    flex: 1;
  }

  .backband__inner::before {
    background: linear-gradient(to left, var(--border-strong), transparent);
  }

  .backband__inner::after {
    background: linear-gradient(to right, var(--border-strong), transparent);
  }

  .backhome {
    --cut: 0.55rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 1rem;
    font-family: var(--font-secondary);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--border-strong);
    /* Cut corner, same polygon as the achievement plates. The clip trims the
       border off the diagonal, which is exactly how the game draws it. */
    clip-path: polygon(
      0 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% 100%,
      0 100%
    );
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .backhome__arrow {
    flex-shrink: 0;
    transition: translate var(--dur) var(--ease);
  }

  .backhome:hover,
  .backhome:focus-visible {
    background: var(--accent);
    color: var(--on-accent);
  }

  /* The arrow leans into the direction of travel. */
  .backhome:hover .backhome__arrow,
  .backhome:focus-visible .backhome__arrow {
    translate: -0.2rem 0;
  }
</style>
