---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import BackHome from "../components/BackHome.astro";
---

<Base
  title="Writing"
  description="Notes on building AI systems that people actually use."
>
  <Section
    eyebrow="Writing"
    title="Notes"
    lede="I write about things I have built, which means this page fills up slowly and on purpose."
  >
    <p class="empty" data-reveal>
      Nothing published yet. First one is on its way.
    </p>
    {/* No portrait rail on this page, so the way home sits under the
        section content instead. */}
    <p class="back" data-reveal>
      <BackHome />
    </p>
  </Section>
</Base>

<style>
  .back {
    margin-block-start: var(--space-m);
  }

  .empty {
    padding: var(--space-l);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
    text-align: center;
  }
</style>
