---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import BackHome from "../../components/BackHome.astro";
import { getPosts, readingMinutes, formatDate } from "../../lib/writing";

/* Published posts only in production; drafts appear under `astro dev`. */
const posts = await getPosts();
---

<Base
  title="Writing"
  description="Notes on building AI systems that people actually use."
>
  <Section
    eyebrow="Writing"
    title="Notes"
    lede="I write about things I have built, which means this page fills up slowly and on purpose."
  >
    {posts.length === 0 ? (
      <p class="empty" data-reveal>
        Nothing published yet. First one is on its way.
      </p>
    ) : (
      <ul class="posts" role="list">
        {posts.map((post, i) => (
          <li data-reveal data-reveal-delay={i * 70}>
            {/* data-page lends the card its class accent from tokens.css,
                so a devlog glows games orange even on the teal index. */}
            <a class="postcard" href={`/writing/${post.id}/`} data-page={post.data.accent}>
              <p class="eyebrow">{post.data.eyebrow}</p>
              <h3 class="postcard__title">{post.data.title}</h3>
              <p class="postcard__summary">{post.data.summary}</p>
              <p class="postcard__meta">
                {post.data.date
                  ? <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  : <span class="postcard__draft">Draft</span>}
                <span aria-hidden="true">·</span>
                <span>{readingMinutes(post.body)} min read</span>
              </p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </Section>
  <BackHome />
</Base>

<style>
  .empty {
    padding: var(--space-l);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
    text-align: center;
  }

  .posts {
    display: grid;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
  }

  /* The same cut-corner card as the project grid, with the accent edge the
     flagship card uses, since every post is a headline item on this page. */
  .postcard {
    --cut: 14px;
    display: grid;
    gap: 0.55rem;
    padding: var(--space-m) var(--space-l);
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--accent);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%);
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .postcard:hover,
  .postcard:focus-visible {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    border-inline-start-color: var(--accent);
    background: var(--surface-hover);
    color: inherit;
  }

  .postcard__title {
    font-size: var(--step-2);
    color: var(--text);
  }

  .postcard:hover .postcard__title { color: var(--accent); }

  .postcard__summary {
    color: var(--text-muted);
  }

  .postcard__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-secondary);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-quiet);
  }

  .postcard__draft { color: var(--cp-red); }
</style>
