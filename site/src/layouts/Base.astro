---
/* Self-hosted fonts, one weight per import so nothing unused ships.
   Rajdhani in the four weights the Cyberpunk 2077 UI uses, Orbitron for
   the secondary text. Vite bundles the woff2 files with the site, so
   there is no third-party request and no FOUT window on Google's side. */
import "@fontsource/rajdhani/400.css";
import "@fontsource/rajdhani/500.css";
import "@fontsource/rajdhani/600.css";
import "@fontsource/rajdhani/700.css";
import "@fontsource/orbitron/400.css";
import "../styles/global.css";
import CyberBackground from "../components/CyberBackground.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /* Set on pages that should not be indexed. */
  noindex?: boolean;
  /* Overrides the accent identity the URL would pick. A writing post takes
     the accent of the class it belongs to: a devlog lives under /writing/
     but burns games orange. */
  accent?: string;
  /* "article" on writing posts; every other page describes the person. */
  type?: "profile" | "article";
  /* Per-page social card, a path under public/. Defaults to the site card. */
  image?: { src: string; width: number; height: number; alt: string };
  published?: Date;
  /* Extra structured data, e.g. a post's BlogPosting, next to the Person. */
  schema?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  noindex = false,
  accent,
  type = "profile",
  image,
  published,
  schema,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} · ${site.role} @ ${site.employer}`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
/* Versioned filename on purpose: WhatsApp and friends cache OG images per
   URL with no refresh mechanism, so a redesign must ship under a new name
   or stale previews linger for days. Bump the version on the next redesign. */
const ogImage = new URL(image?.src ?? "/og-v2.png", Astro.site ?? site.url).href;
const ogWidth = image?.width ?? 1200;
const ogHeight = image?.height ?? 630;
const ogAlt = image?.alt ?? `${site.name}, ${site.role}`;

/* First path segment keys the per-page accent identity in tokens.css.
   Unknown segments (including the 404 page) fall through to the default. */
const pageKey = accent ?? Astro.url.pathname.split("/").filter(Boolean)[0] ?? "home";

/* Structured data. This is what let machines understand the old site once we
   fixed it, and it carries over unchanged in substance. */
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: site.role,
  description: site.tagline,
  worksFor: {
    "@type": "Organization",
    name: "Limitless Technologies SAL",
    url: "https://limitless-tech.ai",
    description: "Health and insurance technology company based in Beirut, Lebanon",
  },
  address: { "@type": "PostalAddress", addressCountry: "LB" },
  knowsAbout: [
    "Artificial Intelligence",
    "Large Language Models",
    "Retrieval-Augmented Generation",
    "Machine Learning",
    "Natural Language Processing",
    "Computer Vision",
    "Prompt Engineering",
    "AI Curriculum Design",
    "Game Development",
  ],
  sameAs: Object.values(site.social),
};
---

<!doctype html>
<html lang="en" data-page={pageKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0f19" />
    {/* Applies before the stylesheet parses, so the very first paint is dark. */}
    <meta name="color-scheme" content="dark" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === "article" && <meta property="article:author" content={site.url} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@JihadFtouny" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/* Synchronous and inline on purpose: it must land before first paint so
        revealable content is never briefly visible and then hidden. */}
    <script is:inline>
      document.documentElement.classList.add("js-reveal");
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <CyberBackground />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      /*
        Scroll reveal. Runs once per element, then disconnects.
        No scroll listener anywhere on this site, which is the other half of
        why the old one stuttered.
      */
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll("[data-reveal]");

      if (reduced || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-revealed"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              const delay = Number(el.dataset.revealDelay ?? 0);
              if (delay) el.style.transitionDelay = `${delay}ms`;
              el.classList.add("is-revealed");
              io.unobserve(el);
            }
          },
          /*
            Fire while the element is still below the fold. A threshold that
            waits for the element to be visible means a fast scroll arrives
            before the transition does, and you land on blank space.
          */
          { threshold: 0, rootMargin: "0px 0px 15% 0px" }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
